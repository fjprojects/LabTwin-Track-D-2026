# Copy to .env at this project root; supply your own values.
GROQ_API_KEY=
DJANGO_SECRET_KEY=replace-with-a-random-production-secret
FRONTEND_URL=http://localhost:5173
# Password recovery: disabled until YOUR encrypted SMTP/sender is configured.
LABTWIN_PASSWORD_RESET_EMAIL_ENABLED=false
# Deployment defaults this to its trusted HTTPS origin; local dev example:
LABTWIN_PASSWORD_RESET_ORIGIN=http://localhost:5173
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=
LITELLM_LOCAL_MODEL_COST_MAP=True
LABTWIN_EMBEDDING_BACKEND=onnx
LABTWIN_TUTOR_MODEL=openai/gpt-oss-20b
# Original programming coach: per-provider-call response deadline, 5–120s.
LABTWIN_LEGACY_AI_TIMEOUT_SECONDS=45
# Use a currently supported Groq vision model for arbitrary raster diagrams.
# Native PDF/PPTX boxes and connector relationships work without a provider.
LABTWIN_VISION_MODEL=
LABTWIN_VERIFIER_MODEL=
LABTWIN_MAX_VISUAL_UNITS=200
# Create a separate venv using requirements-evaluation.txt (see README).
LABTWIN_EVALUATOR_PYTHON=
LABTWIN_EVALUATION_JUDGE_MODEL=
LABTWIN_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
LABTWIN_PROCESS_INLINE=false
# Local mode automatically starts a bounded extraction/evaluation worker.
# For hosting: external mode plus the dedicated commands in README.
LABTWIN_PROCESS_MODE=local
LABTWIN_MATERIAL_TIMEOUT_SECONDS=600
LABTWIN_DEMO_ENABLED=true
LABTWIN_UPLOAD_MAX_BYTES=104857600
LABTWIN_MEDIA_MAX_SECONDS=7200
LABTWIN_VIDEO_OCR=true
# Use persistent private directories in hosting; never serve them as public media.
# LABTWIN_MEDIA_ROOT=/data/private_learning
# LABTWIN_VECTOR_ROOT=/data/learning_vectors
# Optional isolated execution worker. Local execution remains the compatibility default.
LABTWIN_RUNNER_URL=
LABTWIN_RUNNER_SECRET=
# WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# Assessment camera uses bundled local MediaPipe assets; no camera API key.
# Run npm ci and npm run build/dev from frontend. Use HTTPS for camera permission.
